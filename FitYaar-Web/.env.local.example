# Copy to .env.local for local dev.

# Base URL of the FitYaar Spring backend the website talks to.
# Android emulator uses 10.0.2.2; the website (browser) uses localhost.
NEXT_PUBLIC_API_BASE_URL=http://localhost:2098

# Canonical public site URL (used for SEO metadata / sitemap / OpenGraph).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
